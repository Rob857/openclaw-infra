#!/usr/bin/env node
// MCP Auth Proxy — reverse proxy that injects credentials for MCP containers
// on the codex-proxy-net Docker network.
//
// Routes:
//   /health         → health check with per-service status
//   /github-<id>/*  → github.com (per-agent PAT injection for git clone)
//   /anthropic/*    → api.anthropic.com (credential injection for Claude Code + Pi)
//                     Auto-detects token type: OAuth (sk-ant-oat*) → Bearer, API key → x-api-key
//   /codex/<agent>/* → chatgpt.com (per-agent Bearer token injection for Codex)
//   /*               → chatgpt.com (legacy default Codex auth)
//
// Zero npm dependencies. Listens on the Docker network gateway IP only,
// so sandbox containers on the default bridge cannot reach it.
//
// Managed by Ansible — do not edit on the server.

'use strict';

const http = require('http');
const https = require('https');
const fs = require('fs');
const path = require('path');
const { pipeline } = require('stream');

const LISTEN_HOST = process.env.CODEX_PROXY_LISTEN || '127.0.0.1';
const LISTEN_PORT = parseInt(process.env.CODEX_PROXY_PORT || '{{ openclaw_mcp_adapter.codex_proxy_port }}', 10);
const LEGACY_CODEX_AUTH_PATH = process.env.CODEX_AUTH_PATH || '/home/ubuntu/.codex/auth.json';
const CODEX_AUTH_MAP_PATH = process.env.CODEX_AUTH_MAP_PATH || '/home/ubuntu/.openclaw/codex-auth-map.json';
const UPSTREAM_HOST = 'chatgpt.com';
const UPSTREAM_PATH_PREFIX = '/backend-api/codex';
const CONNECT_TIMEOUT_MS = 10000;
const RESPONSE_TIMEOUT_MS = 30000;
const OVERALL_TIMEOUT_MS = 300000; // 5 min for long codex sessions
const REFRESH_URL = 'https://auth.openai.com/oauth/token';
const MAX_BODY_SIZE = 10 * 1024 * 1024; // 10 MB

// --- Structured logging ---

function log(level, msg, extra) {
  const entry = { ts: new Date().toISOString(), level, msg };
  if (extra) Object.assign(entry, extra);
  process.stdout.write(JSON.stringify(entry) + '\n');
}

// --- Token management ---

let cachedCodexAuthMap = null;
let cachedCodexAuthMapMtime = 0;
const codexTokenCache = new Map(); // auth-key -> { token, mtime, lastSuccessfulRead }
const codexRefreshMutex = new Map(); // auth-key -> Promise
const codexCircuitState = new Map(); // auth-key -> { openUntil }
const STALE_TOKEN_THRESHOLD_MS = 60 * 60 * 1000; // 1 hour

function getCodexState(authKey) {
  const cached = codexTokenCache.get(authKey);
  return cached || { token: null, mtime: 0, lastSuccessfulRead: 0 };
}

function setCodexState(authKey, nextState) {
  codexTokenCache.set(authKey, nextState);
}

function getCircuitState(authKey) {
  const cached = codexCircuitState.get(authKey);
  return cached || { openUntil: 0 };
}

function openCircuit(authKey) {
  codexCircuitState.set(authKey, { openUntil: Date.now() + 5 * 60 * 1000 });
}

function clearCircuit(authKey) {
  codexCircuitState.set(authKey, { openUntil: 0 });
}

function isCircuitOpen(authKey) {
  return getCircuitState(authKey).openUntil > Date.now();
}

function normalizeAuthPathList(value, fallbackPath) {
  const paths = Array.isArray(value) ? value : (typeof value === 'string' ? [value] : []);
  const normalized = paths.map((item) => typeof item === 'string' ? item.trim() : '').filter(Boolean);
  return normalized.length > 0 ? normalized : [fallbackPath];
}

function normalizeCodexAuthMap(raw) {
  const normalized = { default: [LEGACY_CODEX_AUTH_PATH], agents: {} };

  if (raw && Object.prototype.hasOwnProperty.call(raw, 'default')) {
    normalized.default = normalizeAuthPathList(raw.default, LEGACY_CODEX_AUTH_PATH);
  }

  if (raw && raw.agents && typeof raw.agents === 'object') {
    for (const [agentId, authPath] of Object.entries(raw.agents)) {
      const list = normalizeAuthPathList(authPath, LEGACY_CODEX_AUTH_PATH);
      if (list.length > 0) {
        normalized.agents[agentId] = list;
      }
    }
  }

  return normalized;
}

function loadCodexAuthMap() {
  try {
    const stat = fs.statSync(CODEX_AUTH_MAP_PATH);
    if (cachedCodexAuthMap && stat.mtimeMs === cachedCodexAuthMapMtime) {
      return cachedCodexAuthMap;
    }
    const raw = JSON.parse(fs.readFileSync(CODEX_AUTH_MAP_PATH, 'utf8'));
    cachedCodexAuthMap = normalizeCodexAuthMap(raw);
    cachedCodexAuthMapMtime = stat.mtimeMs;
    return cachedCodexAuthMap;
  } catch (err) {
    if (err.code !== 'ENOENT') {
      log('warn', 'Failed to read Codex auth map, using legacy default', { error: err.message });
    }
    cachedCodexAuthMap = normalizeCodexAuthMap(null);
    cachedCodexAuthMapMtime = 0;
    return cachedCodexAuthMap;
  }
}

function resolveCodexAuth(agentId) {
  const authMap = loadCodexAuthMap();
  if (agentId && authMap.agents[agentId]) {
    return { authKey: agentId, agentId, authPaths: authMap.agents[agentId] };
  }
  return { authKey: 'default', agentId: agentId || 'default', authPaths: authMap.default || [LEGACY_CODEX_AUTH_PATH] };
}

function readCodexAuthFile(authPath) {
  try {
    return JSON.parse(fs.readFileSync(authPath, 'utf8'));
  } catch (err) {
    log('error', 'Failed to read Codex auth file', { authPath, error: err.message });
    return null;
  }
}

function getAccessToken(authKey, authPath) {
  const state = getCodexState(authKey);
  try {
    const stat = fs.statSync(authPath);
    const mtime = stat.mtimeMs;
    if (state.token && mtime === state.mtime) return state.token;
    const data = readCodexAuthFile(authPath);
    const tokens = data && data.tokens;
    if (tokens && tokens.access_token) {
      setCodexState(authKey, {
        token: tokens.access_token,
        mtime,
        lastSuccessfulRead: Date.now(),
      });
      log('info', 'Loaded Codex access token', { authKey, authPath });
      return tokens.access_token;
    }
  } catch (err) {
    if (!state.token) {
      throw new Error(`Cannot read Codex auth file (${authPath}) and no cached token available: ${err.message}`);
    }
    const staleDuration = Date.now() - state.lastSuccessfulRead;
    if (state.lastSuccessfulRead > 0 && staleDuration > STALE_TOKEN_THRESHOLD_MS) {
      log('error', 'Codex auth file unreadable and cached token is stale', {
        authKey,
        authPath,
        error: err.message,
        lastSuccessfulReadAgo: Math.round(staleDuration / 1000) + 's',
      });
    } else {
      log('warn', 'Codex auth file unreadable, using cached token', { authKey, authPath, error: err.message });
    }
  }
  return state.token;
}

function invalidateToken(authKey) {
  const state = getCodexState(authKey);
  setCodexState(authKey, {
    token: null,
    mtime: 0,
    lastSuccessfulRead: state.lastSuccessfulRead,
  });
}

function buildCodexCandidates(codexTarget) {
  return (codexTarget.authPaths || [LEGACY_CODEX_AUTH_PATH]).map((authPath, index) => ({
    // Key token cache and refresh mutexes by auth file, not by agent.
    // In shared-auth mode multiple agents intentionally point at the same
    // Codex OAuth file; per-agent keys would refresh the same token in
    // parallel and invalidate the losers with refresh_token_reused.
    authKey: `path:${path.resolve(authPath)}`,
    authPath,
    agentId: codexTarget.agentId,
  }));
}

// --- Anthropic token management (static key from file, no refresh) ---

const ANTHROPIC_AUTH_PATH = process.env.ANTHROPIC_AUTH_PATH || '/home/ubuntu/.openclaw/anthropic-auth-token';
let cachedAnthropicToken = null;
let anthropicTokenMtime = 0;

function getAnthropicToken() {
  try {
    const stat = fs.statSync(ANTHROPIC_AUTH_PATH);
    if (cachedAnthropicToken && stat.mtimeMs === anthropicTokenMtime) return cachedAnthropicToken;
    const token = fs.readFileSync(ANTHROPIC_AUTH_PATH, 'utf8').trim();
    if (!token) {
      log('error', 'Anthropic token file exists but is empty', { path: ANTHROPIC_AUTH_PATH });
      return null;
    }
    cachedAnthropicToken = token;
    anthropicTokenMtime = stat.mtimeMs;
    log('info', 'Loaded Anthropic token from file');
    return cachedAnthropicToken;
  } catch (err) {
    log('error', 'Failed to read Anthropic token', { error: err.message });
    return null;
  }
}

// Watch for rotation, with retry if file doesn't exist yet
function watchAnthropicToken() {
  try {
    fs.watch(ANTHROPIC_AUTH_PATH, () => {
      log('info', 'Anthropic token file changed, invalidating cache');
      cachedAnthropicToken = null;
      anthropicTokenMtime = 0;
    });
    log('info', 'Watching Anthropic token file for changes');
    return true;
  } catch (err) {
    log('warn', 'Cannot watch Anthropic token file, retrying in 30s', { error: err.message });
    return false;
  }
}
if (!watchAnthropicToken()) {
  const retryWatch = setInterval(() => {
    if (watchAnthropicToken()) clearInterval(retryWatch);
  }, 30000);
}

// --- GitHub token management (per-agent PATs from directory) ---

const GITHUB_TOKENS_DIR = process.env.GITHUB_TOKENS_DIR || '/home/ubuntu/.openclaw/github-tokens';
const GITHUB_OVERALL_TIMEOUT_MS = 600000; // 10 min for large git pushes
const githubTokenCache = new Map(); // agent-id → { token, mtime }

function getGitHubToken(agentId) {
  const filePath = path.join(GITHUB_TOKENS_DIR, agentId);
  try {
    const stat = fs.statSync(filePath);
    const cached = githubTokenCache.get(agentId);
    if (cached && stat.mtimeMs === cached.mtime) return cached.token;
    const token = fs.readFileSync(filePath, 'utf8').trim();
    if (!token) return null;
    githubTokenCache.set(agentId, { token, mtime: stat.mtimeMs });
    log('info', 'Loaded GitHub token', { agent: agentId });
    return token;
  } catch (err) {
    if (err.code !== 'ENOENT') log('error', 'Failed to read GitHub token', { agent: agentId, error: err.message });
    return null;
  }
}

function getGitHubAgents() {
  try {
    return fs.readdirSync(GITHUB_TOKENS_DIR).filter(f => !f.startsWith('.'));
  } catch (err) {
    if (err.code !== 'ENOENT') log('warn', 'Cannot read GitHub tokens directory', { error: err.message });
    return [];
  }
}

// Watch for token rotation
try {
  fs.watch(GITHUB_TOKENS_DIR, (_, filename) => {
    if (filename) {
      log('info', 'GitHub token file changed, invalidating cache', { agent: filename });
      githubTokenCache.delete(filename);
    }
  });
  log('info', 'Watching GitHub tokens directory for changes');
} catch (err) {
  if (err.code !== 'ENOENT') log('warn', 'Cannot watch GitHub tokens directory', { error: err.message });
}

// --- Token refresh ---

function refreshToken(authKey, authPath) {
  if (codexRefreshMutex.has(authKey)) return codexRefreshMutex.get(authKey);

  if (isCircuitOpen(authKey)) {
    return Promise.reject(new Error('Circuit breaker open — refresh disabled'));
  }

  const refreshPromise = new Promise((resolve, reject) => {
    const auth = readCodexAuthFile(authPath);
    const tokens = auth && auth.tokens;
    if (!tokens || !tokens.refresh_token) {
      reject(new Error(`No refresh_token in Codex auth file (${authPath})`));
      return;
    }

    const body = JSON.stringify({
      grant_type: 'refresh_token',
      refresh_token: tokens.refresh_token,
      client_id: '{{ openclaw_mcp_adapter.codex_oauth_client_id }}',
    });

    const req = https.request(REFRESH_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(body),
      },
      timeout: CONNECT_TIMEOUT_MS,
    }, (res) => {
      let data = '';
      res.on('data', (chunk) => { data += chunk; });
      res.on('end', () => {
        if (res.statusCode !== 200) {
          log('error', 'Codex token refresh failed', { authKey, authPath, status: res.statusCode, body: data.slice(0, 500) });
          openCircuit(authKey);
          reject(new Error(`Refresh returned ${res.statusCode}`));
          return;
        }
        try {
          const parsed = JSON.parse(data);
          if (!parsed.access_token) throw new Error('No access_token in refresh response');
          // Update auth.json on disk (tokens are nested under .tokens)
          const updatedTokens = Object.assign({}, tokens, {
            access_token: parsed.access_token,
            refresh_token: parsed.refresh_token || tokens.refresh_token,
          });
          const updated = Object.assign({}, auth, {
            tokens: updatedTokens,
            last_refresh: new Date().toISOString(),
          });
          fs.writeFileSync(authPath, JSON.stringify(updated, null, 2), 'utf8');
          setCodexState(authKey, {
            token: parsed.access_token,
            mtime: fs.statSync(authPath).mtimeMs,
            lastSuccessfulRead: Date.now(),
          });
          clearCircuit(authKey);
          log('info', 'Codex token refreshed successfully', { authKey, authPath });
          resolve(parsed.access_token);
        } catch (err) {
          reject(err);
        }
      });
    });

    req.on('error', (err) => {
      log('error', 'Codex token refresh request error', { authKey, authPath, error: err.message });
      openCircuit(authKey);
      reject(err);
    });
    req.on('timeout', () => { req.destroy(new Error('Refresh request timeout')); });
    req.write(body);
    req.end();
  }).finally(() => { codexRefreshMutex.delete(authKey); });

  codexRefreshMutex.set(authKey, refreshPromise);
  return refreshPromise;
}

// --- Proxy logic ---

function bufferBody(req) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    let size = 0;
    req.on('data', (chunk) => {
      size += chunk.length;
      if (size > MAX_BODY_SIZE) {
        reject(new Error('Request body too large'));
        req.destroy();
        return;
      }
      chunks.push(chunk);
    });
    req.on('end', () => resolve(Buffer.concat(chunks)));
    req.on('error', reject);
  });
}

function parseCodexRequest(urlPath) {
  const match = urlPath.match(/^\/codex\/([^/]+)(\/.*)?$/);
  if (match) {
    return {
      agentId: match[1],
      upstreamPath: match[2] || '/',
    };
  }
  return {
    agentId: null,
    upstreamPath: urlPath,
  };
}

function proxyRequest(clientReq, clientRes, body, codexTarget, token, isRetry, candidateIndex) {
  const upstreamPath = UPSTREAM_PATH_PREFIX + codexTarget.upstreamPath;
  const headers = Object.assign({}, clientReq.headers);
  delete headers.host;
  headers.host = UPSTREAM_HOST;
  headers.authorization = 'Bearer ' + token;
  headers['content-length'] = Buffer.byteLength(body);

  const options = {
    hostname: UPSTREAM_HOST,
    port: 443,
    path: upstreamPath,
    method: clientReq.method,
    headers: headers,
    timeout: CONNECT_TIMEOUT_MS,
  };

  const upReq = https.request(options, (upRes) => {
    // Handle 401 — try refresh once
    if (upRes.statusCode === 401 && !isRetry) {
      // Drain upstream response
      upRes.resume();
      log('warn', 'Codex upstream returned 401, attempting token refresh', { authKey: codexTarget.authKey, candidateIndex, agent: codexTarget.agentId });
      invalidateToken(codexTarget.authKey);
      refreshToken(codexTarget.authKey, codexTarget.authPath).then((newToken) => {
        proxyRequest(clientReq, clientRes, body, codexTarget, newToken, true, candidateIndex);
      }).catch((err) => {
        log('warn', 'Codex token refresh failed on 401 retry, trying next candidate if available', { authKey: codexTarget.authKey, candidateIndex, agent: codexTarget.agentId, error: err.message });
        proxyRequestCandidates(clientReq, clientRes, body, codexTarget.candidates, candidateIndex + 1, {
          error: err,
          reason: 'token_refresh_failed',
        });
      });
      return;
    }

    if ((upRes.statusCode === 429 || upRes.statusCode >= 500) && candidateIndex + 1 < codexTarget.candidates.length) {
      upRes.resume();
      log('warn', 'Codex upstream returned retryable status, trying next candidate', {
        status: upRes.statusCode,
        authKey: codexTarget.authKey,
        candidateIndex,
        agent: codexTarget.agentId,
      });
      invalidateToken(codexTarget.authKey);
      openCircuit(codexTarget.authKey);
      proxyRequestCandidates(clientReq, clientRes, body, codexTarget.candidates, candidateIndex + 1, {
        error: new Error(`Upstream returned ${upRes.statusCode}`),
        reason: 'retryable_status',
      });
      return;
    }

    // Validate upstream content type
    const ct = (upRes.headers['content-type'] || '').toLowerCase();
    if (upRes.statusCode >= 200 && upRes.statusCode < 300 &&
        !ct.includes('json') && !ct.includes('event-stream') && !ct.includes('text/')) {
      log('warn', 'Unexpected upstream content-type', { contentType: ct, status: upRes.statusCode });
    }

    // Forward response
    clientRes.writeHead(upRes.statusCode, upRes.headers);
    pipeline(upRes, clientRes, (err) => {
      if (err && err.code !== 'ERR_STREAM_PREMATURE_CLOSE') {
        log('error', 'Stream pipeline error', { error: err.message });
      }
    });
  });

  // Timeouts
  upReq.on('timeout', () => {
    upReq.destroy(new Error('Upstream connect timeout'));
  });

  upReq.on('socket', (socket) => {
    socket.once('connect', () => {
      // After connect, set response timeout
      upReq.setTimeout(RESPONSE_TIMEOUT_MS, () => {
        upReq.destroy(new Error('Upstream response timeout'));
      });
    });
  });

  upReq.on('error', (err) => {
    log('warn', 'Codex upstream request error', { error: err.message, path: upstreamPath, authKey: codexTarget.authKey, candidateIndex, agent: codexTarget.agentId });
    if (candidateIndex + 1 < codexTarget.candidates.length) {
      invalidateToken(codexTarget.authKey);
      openCircuit(codexTarget.authKey);
      proxyRequestCandidates(clientReq, clientRes, body, codexTarget.candidates, candidateIndex + 1, {
        error: err,
        reason: 'upstream_error',
      });
      return;
    }
    if (!clientRes.headersSent) {
      clientRes.writeHead(502, { 'Content-Type': 'application/json' });
      clientRes.end(JSON.stringify({ error: 'upstream_error', detail: err.message }));
    }
  });

  upReq.write(body);
  upReq.end();

  // Overall timeout
  const overallTimer = setTimeout(() => {
    upReq.destroy(new Error('Overall request timeout'));
  }, OVERALL_TIMEOUT_MS);
  clientRes.on('close', () => clearTimeout(overallTimer));
}

function proxyRequestCandidates(clientReq, clientRes, body, candidates, candidateIndex, retryContext) {
  const candidate = candidates[candidateIndex];
  if (!candidate) {
    const detail = retryContext && retryContext.error ? retryContext.error.message : 'No Codex auth candidates available';
    clientRes.writeHead(503, { 'Content-Type': 'application/json' });
    clientRes.end(JSON.stringify({ error: retryContext && retryContext.reason ? retryContext.reason : 'no_token', detail }));
    return;
  }

  let token;
  try {
    token = getAccessToken(candidate.authKey, candidate.authPath);
  } catch (err) {
    log('warn', 'Failed to read Codex candidate token, trying next candidate', { authKey: candidate.authKey, candidateIndex, agent: candidate.agentId, error: err.message });
    proxyRequestCandidates(clientReq, clientRes, body, candidates, candidateIndex + 1, { error: err, reason: 'no_token' });
    return;
  }

  if (!token) {
    log('warn', 'Codex candidate token unavailable, trying next candidate', { authKey: candidate.authKey, candidateIndex, agent: candidate.agentId });
    proxyRequestCandidates(clientReq, clientRes, body, candidates, candidateIndex + 1, { error: new Error('No cached token available'), reason: 'no_token' });
    return;
  }

  proxyRequest(clientReq, clientRes, body, {
    authKey: candidate.authKey,
    authPath: candidate.authPath,
    agentId: candidate.agentId,
    upstreamPath: (retryContext && retryContext.upstreamPath) || parseCodexRequest(clientReq.url).upstreamPath,
    candidates,
  }, token, false, candidateIndex);
}

function proxyAnthropicRequest(clientReq, clientRes, body) {
  const token = getAnthropicToken();
  if (!token) {
    clientRes.writeHead(503, { 'Content-Type': 'application/json' });
    clientRes.end(JSON.stringify({ error: 'no_token', detail: 'Cannot read Anthropic token' }));
    return;
  }

  const upstreamPath = clientReq.url.slice('/anthropic'.length) || '/';
  const headers = Object.assign({}, clientReq.headers);
  delete headers.host;
  delete headers['x-api-key'];
  delete headers['authorization'];
  delete headers['transfer-encoding'];
  headers.host = 'api.anthropic.com';
  // Auto-detect token type: OAuth setup tokens (sk-ant-oat*) require Bearer auth
  // with the oauth-2025-04-20 beta flag. Standard API keys use x-api-key header.
  if (token.startsWith('sk-ant-oat')) {
    headers['authorization'] = 'Bearer ' + token;
    headers['anthropic-dangerous-direct-browser-access'] = 'true';
    // Merge oauth-2025-04-20 into anthropic-beta (preserve existing beta flags)
    const existing = (headers['anthropic-beta'] || '').split(',').map(s => s.trim()).filter(Boolean);
    if (!existing.includes('oauth-2025-04-20')) existing.push('oauth-2025-04-20');
    headers['anthropic-beta'] = existing.join(',');
  } else {
    headers['x-api-key'] = token;
  }
  headers['content-length'] = Buffer.byteLength(body);

  const options = {
    hostname: 'api.anthropic.com',
    port: 443,
    path: upstreamPath,
    method: clientReq.method,
    headers: headers,
    timeout: CONNECT_TIMEOUT_MS,
  };

  const upReq = https.request(options, (upRes) => {
    clientRes.writeHead(upRes.statusCode, upRes.headers);
    pipeline(upRes, clientRes, (err) => {
      if (err && err.code !== 'ERR_STREAM_PREMATURE_CLOSE')
        log('error', 'Anthropic stream error', { error: err.message });
    });
  });

  upReq.on('timeout', () => upReq.destroy(new Error('Anthropic connect timeout')));
  upReq.on('socket', (socket) => {
    socket.once('connect', () => {
      upReq.setTimeout(RESPONSE_TIMEOUT_MS, () =>
        upReq.destroy(new Error('Anthropic response timeout')));
    });
  });
  upReq.on('error', (err) => {
    log('error', 'Anthropic upstream error', { error: err.message, path: upstreamPath });
    if (!clientRes.headersSent) {
      clientRes.writeHead(502, { 'Content-Type': 'application/json' });
      clientRes.end(JSON.stringify({ error: 'upstream_error', detail: err.message }));
    }
  });

  upReq.write(body);
  upReq.end();

  const overallTimer = setTimeout(() => {
    upReq.destroy(new Error('Anthropic overall timeout'));
  }, OVERALL_TIMEOUT_MS);
  clientRes.on('close', () => clearTimeout(overallTimer));
}

// --- GitHub proxy (streaming, per-agent PAT injection) ---

function proxyGitHubRequest(clientReq, clientRes) {
  // Parse /github-<agent-id>/owner/repo.git/... from URL
  const match = clientReq.url.match(/^\/github-([^/]+)(\/.*)?$/);
  if (!match) {
    clientRes.writeHead(400, { 'Content-Type': 'application/json' });
    clientRes.end(JSON.stringify({ error: 'bad_request', detail: 'Invalid GitHub proxy URL format' }));
    return;
  }

  const agentId = match[1];
  const upstreamPath = match[2] || '/';
  const token = getGitHubToken(agentId);
  if (!token) {
    clientRes.writeHead(404, { 'Content-Type': 'application/json' });
    clientRes.end(JSON.stringify({ error: 'no_token', detail: `No GitHub token for agent '${agentId}'` }));
    return;
  }

  const headers = Object.assign({}, clientReq.headers);
  delete headers.host;
  delete headers.authorization;
  headers.host = 'github.com';
  // GitHub git smart HTTP requires Basic auth (not Bearer)
  headers.authorization = 'Basic ' + Buffer.from('x-access-token:' + token).toString('base64');

  const options = {
    hostname: 'github.com',
    port: 443,
    path: upstreamPath,
    method: clientReq.method,
    headers: headers,
    timeout: CONNECT_TIMEOUT_MS,
  };

  const upReq = https.request(options, (upRes) => {
    clientRes.writeHead(upRes.statusCode, upRes.headers);
    pipeline(upRes, clientRes, (err) => {
      if (err && err.code !== 'ERR_STREAM_PREMATURE_CLOSE')
        log('error', 'GitHub stream error', { error: err.message, agent: agentId });
    });
  });

  upReq.on('timeout', () => upReq.destroy(new Error('GitHub connect timeout')));
  upReq.on('socket', (socket) => {
    socket.once('connect', () => {
      upReq.setTimeout(RESPONSE_TIMEOUT_MS, () =>
        upReq.destroy(new Error('GitHub response timeout')));
    });
  });
  upReq.on('error', (err) => {
    log('error', 'GitHub upstream error', { error: err.message, path: upstreamPath, agent: agentId });
    if (!clientRes.headersSent) {
      clientRes.writeHead(502, { 'Content-Type': 'application/json' });
      clientRes.end(JSON.stringify({ error: 'upstream_error', detail: err.message }));
    } else {
      clientRes.destroy();
    }
    clientReq.destroy();
  });

  // Stream request body (git packfiles can be huge — do NOT buffer)
  clientReq.on('error', (err) => {
    log('error', 'GitHub client request error', { error: err.message, agent: agentId });
    upReq.destroy();
  });
  clientReq.pipe(upReq);

  const overallTimer = setTimeout(() => {
    upReq.destroy(new Error('GitHub overall timeout'));
    clientReq.destroy();
  }, GITHUB_OVERALL_TIMEOUT_MS);
  clientRes.on('close', () => clearTimeout(overallTimer));
}

// --- HTTP server ---

const server = http.createServer((req, res) => {
  // Health check — per-service status
  if (req.url === '/health' && req.method === 'GET') {
    const codexAuthMap = loadCodexAuthMap();
    const codexStatus = {};

    const defaultTarget = resolveCodexAuth(null);
    const defaultCandidates = buildCodexCandidates(defaultTarget);
    const defaultCandidatesStatus = defaultCandidates.map((candidate) => {
      let token = null;
      try { token = getAccessToken(candidate.authKey, candidate.authPath); } catch (err) { /* no cached token */ }
      return {
        authKey: candidate.authKey,
        authPath: candidate.authPath,
        hasToken: !!token,
        healthy: !!token && !isCircuitOpen(candidate.authKey),
        circuitOpen: isCircuitOpen(candidate.authKey),
        circuitOpenUntil: isCircuitOpen(candidate.authKey) ? new Date(getCircuitState(candidate.authKey).openUntil).toISOString() : null,
      };
    });
    codexStatus.default = {
      authPaths: defaultTarget.authPaths,
      candidates: defaultCandidatesStatus,
      hasToken: defaultCandidatesStatus.some((candidate) => candidate.hasToken),
      healthy: defaultCandidatesStatus.some((candidate) => candidate.healthy),
      circuitOpen: defaultCandidatesStatus.some((candidate) => candidate.circuitOpen),
    };

    for (const agentId of Object.keys(codexAuthMap.agents)) {
      const target = resolveCodexAuth(agentId);
      const candidates = buildCodexCandidates(target);
      const candidateStatus = candidates.map((candidate) => {
        let token = null;
        try { token = getAccessToken(candidate.authKey, candidate.authPath); } catch (err) { /* no cached token */ }
        return {
          authKey: candidate.authKey,
          authPath: candidate.authPath,
          hasToken: !!token,
          healthy: !!token && !isCircuitOpen(candidate.authKey),
          circuitOpen: isCircuitOpen(candidate.authKey),
          circuitOpenUntil: isCircuitOpen(candidate.authKey) ? new Date(getCircuitState(candidate.authKey).openUntil).toISOString() : null,
        };
      });
      codexStatus[agentId] = {
        authPaths: target.authPaths,
        candidates: candidateStatus,
        hasToken: candidateStatus.some((candidate) => candidate.hasToken),
        healthy: candidateStatus.some((candidate) => candidate.healthy),
        circuitOpen: candidateStatus.some((candidate) => candidate.circuitOpen),
      };
    }

    const anthropicToken = getAnthropicToken();
    const githubAgents = getGitHubAgents();
    const codexHealthy = Object.values(codexStatus).some((entry) => entry.healthy);
    const anthropicHealthy = !!anthropicToken;
    const healthy = codexHealthy || anthropicHealthy || githubAgents.length > 0;
    res.writeHead(healthy ? 200 : 503, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({
      status: healthy ? 'healthy' : 'unhealthy',
      codex: {
        healthy: codexHealthy,
        accounts: codexStatus,
      },
      anthropic: { hasToken: !!anthropicToken, healthy: anthropicHealthy, authMethod: anthropicToken && anthropicToken.startsWith('sk-ant-oat') ? 'bearer' : 'api-key' },
      github: { agents: githubAgents, hasTokens: githubAgents.length > 0 },
    }));
    return;
  }

  // GitHub route — per-agent PAT injection for git clone/push (streaming, no body buffering)
  if (req.url.match(/^\/github-[^/]+/)) {
    proxyGitHubRequest(req, res);
    return;
  }

  // Anthropic route — Claude Code + Pi containers
  if (req.url.startsWith('/anthropic/') || req.url === '/anthropic') {
    bufferBody(req).then((body) => {
      proxyAnthropicRequest(req, res, body);
    }).catch((err) => {
      log('error', 'Failed to buffer Anthropic request body', { error: err.message });
      if (!res.headersSent) {
        res.writeHead(400, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ error: 'bad_request', detail: err.message }));
      }
    });
    return;
  }

  // Default: Codex route
  const codexRequest = parseCodexRequest(req.url);
  const codexTarget = resolveCodexAuth(codexRequest.agentId);
  bufferBody(req).then((body) => {
    proxyRequestCandidates(req, res, body, buildCodexCandidates({
      authKey: codexTarget.authKey,
      agentId: codexTarget.agentId,
      authPaths: codexTarget.authPaths,
    }), 0, {
      error: null,
      reason: 'start',
      upstreamPath: codexRequest.upstreamPath,
    });
  }).catch((err) => {
    log('error', 'Failed to buffer request body', { error: err.message });
    if (!res.headersSent) {
      res.writeHead(400, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ error: 'bad_request', detail: err.message }));
    }
  });
});

server.listen(LISTEN_PORT, LISTEN_HOST, () => {
  log('info', 'MCP auth proxy started', { host: LISTEN_HOST, port: LISTEN_PORT });
  const defaultTarget = resolveCodexAuth(null);
  for (const candidate of buildCodexCandidates(defaultTarget)) {
    try {
      getAccessToken(candidate.authKey, candidate.authPath);
    } catch (err) {
      log('warn', 'Default Codex auth candidate not available at startup', { authPath: candidate.authPath, error: err.message });
    }
  }
  getAnthropicToken();
});

server.on('error', (err) => {
  log('error', 'Server error', { error: err.message });
  process.exit(1);
});

// Graceful shutdown
process.on('SIGTERM', () => {
  log('info', 'SIGTERM received, shutting down');
  server.close(() => process.exit(0));
  setTimeout(() => process.exit(1), 5000);
});
process.on('SIGINT', () => {
  log('info', 'SIGINT received, shutting down');
  server.close(() => process.exit(0));
  setTimeout(() => process.exit(1), 5000);
});
